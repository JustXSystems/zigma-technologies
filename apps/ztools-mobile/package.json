{
  "name": "ztools-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.11",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/native": "^7.3.16",
    "@react-navigation/native-stack": "^7.18.8",
    "expo": "~57.0.13",
    "expo-constants": "~57.0.11",
    "expo-device": "~57.0.1",
    "expo-notifications": "~57.0.11",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "sharp": "^0.35.3",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "scripts": {
    "start": "node scripts/check-node-version.mjs && expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "icons": "node ./scripts/generate-icons.mjs",
    "lan-ip": "node ./scripts/print-lan-ip.mjs",
    "test:api": "node ./scripts/smoke-test.mjs",
    "check:android": "powershell -ExecutionPolicy Bypass -File ./scripts/check-android.ps1",
    "emulator:list": "powershell -ExecutionPolicy Bypass -File ./scripts/emulator-list.ps1",
    "emulator:start": "powershell -ExecutionPolicy Bypass -File ./scripts/emulator-start.ps1",
    "emulator:reset": "powershell -ExecutionPolicy Bypass -File ./scripts/emulator-reset.ps1",
    "emulator:wait": "powershell -ExecutionPolicy Bypass -File ./scripts/emulator-wait.ps1",
    "emulator:network": "powershell -ExecutionPolicy Bypass -File ./scripts/emulator-network.ps1",
    "adb:devices": "powershell -ExecutionPolicy Bypass -File ./scripts/adb-devices.ps1",
    "diagnose": "powershell -ExecutionPolicy Bypass -File ./scripts/diagnose-emulator.ps1",
    "android:emu": "node scripts/check-node-version.mjs && powershell -ExecutionPolicy Bypass -File ./scripts/run-android.ps1",
    "android:emu:tunnel": "node scripts/check-node-version.mjs && powershell -ExecutionPolicy Bypass -File ./scripts/run-android-tunnel.ps1",
    "expo:android": "node scripts/check-node-version.mjs && powershell -ExecutionPolicy Bypass -File ./scripts/run-expo-android.ps1"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
