# Zigma site URL used by the ZTools Android app (no trailing slash).
# Production:
EXPO_PUBLIC_ZTOOLS_API_URL=https://zigma-technologies.com

# Optional — override EAS project ID for Expo push (defaults to app.json extra.eas.projectId)
# EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id

# Local dev — Android emulator (maps host machine localhost):
# EXPO_PUBLIC_ZTOOLS_API_URL=http://10.0.2.2:3000

# Local dev — physical device on same Wi‑Fi (use your PC LAN IP):
# EXPO_PUBLIC_ZTOOLS_API_URL=http://192.168.1.10:3000
