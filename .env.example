DB_HOST=localhost
DB_PORT=3306
DB_USER=zigmatech
DB_PASSWORD=devpassword
DB_NAME=zigmatech
AUTH_SECRET=zigma-dev-auth-secret-change-me
PREVIEW_SECRET=zigma-dev-preview-secret-change-me
ADMIN_EMAIL=admin@zigma-technologies.com
ADMIN_PASSWORD=ChangeMeNow!123
ADMIN_NAME=Site Admin
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Subdirectory PreProd only on JustXSystems VPS (omit for domain-root Production / local DEV):
# NEXT_PUBLIC_BASE_PATH=/zigma-technologies
# NEXT_PUBLIC_SITE_URL=https://justxsystems.com/zigma-technologies
# Must be set BEFORE `npm run build` (baked into the client bundle).
# PreProd VPS:  deploy@193.203.161.219  → /var/www/zigma-technologies (PM2 zigma-preprod :3001)
# Production VPS: deploy@200.234.45.106 → /var/www/zigma-technologies (no BASE_PATH, PM2 zigma :3000)

# SEO — set NEXT_PUBLIC_SEO_INDEXABLE=true ONLY on the Production build (zigma-technologies.com).
# Anything else (DEV, PreProd, UAT) is served noindex + X-Robots-Tag and an empty sitemap. Baked in at build time.
# PreProd also sets NEXT_PUBLIC_BASE_PATH — isIndexable() refuses indexing when basePath is set (extra guard).
# Never set SEO_INDEXABLE=true on PreProd .env; deploy.sh and CI will refuse / fail verify-seo-build.mjs.
NEXT_PUBLIC_SEO_INDEXABLE=
# Optional: Search Console / Bing Webmaster verification tokens (content value of the meta tag only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Media URL prefix (default /assets, or {BASE_PATH}/assets when basePath is set).
# Admin CMS files → /public/assets/{images|svg|video}
# Visitor form uploads → /public/assets/uploads/{resumes|documents}
MEDIA_BASE_URL=/assets
# Admin media library max upload size in megabytes (match nginx client_max_body_size on the VPS)
MEDIA_UPLOAD_MAX_MB=100

# Email is configured in Admin → Email (Microsoft 365 Graph recommended). Secrets saved there are
# AES-256-GCM encrypted with this key (falls back to AUTH_SECRET). Changing it requires re-entering them.
MAIL_ENCRYPTION_KEY=
# Legacy fallback, used only until Admin → Email is saved (or when SMTP host is left blank there)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Zigma Technologies <noreply@zigma-technologies.com>"

# Optional Cloudflare Turnstile (public forms). Leave blank to disable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Meridian SaaS bridge (P5, optional) — default local forever ops unchanged ---
# MERIDIAN_MODE=local          # local | dual | saas
# MERIDIAN_SAAS_URL=https://justxsystems.com/jbt/tools/seo-meridian
# MERIDIAN_SAAS_API_KEY=jbt_…  # site API key from Meridian Connect → Product Agent
# MERIDIAN_SAAS_SITE_ID=       # optional; desk URL also from GET /api/v1/me

# --- Meridian Product Agent (P4 Next kit) — GET /api/meridian-agent polls patches ---
# MERIDIAN_SITE_API_KEY=jbt_…  # same key as MERIDIAN_SAAS_API_KEY (Connect → Agents / Next kit)
# Also needs app/api/meridian-seo-file + next.config rewrites for BingSiteAuth.xml / IndexNow *.txt

