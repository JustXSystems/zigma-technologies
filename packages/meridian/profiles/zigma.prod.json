{
  "schemaVersion": 1,
  "id": "zigma-prod",
  "displayName": "Zigma Technologies (Production)",
  "brand": {
    "name": "Zigma Technologies",
    "maxBrandMentionsInTitle": 1
  },
  "origin": "https://zigma-technologies.com",
  "indexable": true,
  "wwwHost": "https://www.zigma-technologies.com",
  "samplePaths": [
    "/",
    "/projects",
    "/products",
    "/services",
    "/locations",
    "/locations/bengaluru",
    "/contact"
  ],
  "expectNoindex": [
    "/thank-you",
    "/locations/bengaluru/ups-amc"
  ],
  "allowRedirectHome": ["/search"],
  "sampleDetailPath": "/projects/amc-engineering-college-200kw-bangalore",
  "minSitemapLocs": 20,
  "connectors": {
    "http-site": { "enabled": true },
    "gsc": { "enabled": true, "siteUrl": "sc-domain:zigma-technologies.com" },
    "bing": { "enabled": true },
    "ga4": { "enabled": true, "measurementIdHint": "G-RFXQRYYX48" },
    "pagespeed": { "enabled": true },
    "cmsGaps": { "enabled": true, "script": "scripts/meridian-cms-gaps.mjs" },
    "cms": { "enabled": false, "adapter": "zigma" }
  },
  "autopilot": {
    "inspectLimit": 5,
    "deltaLimit": 10,
    "healthLimit": 120,
    "thinWords": 280,
    "maxImageBytes": 350000,
    "autoApplyMeta": true,
    "autoApplyAlt": true,
    "autoApplyOrphans": true,
    "autoOptimizeImages": true,
    "autoSeedContent": true,
    "autoPolishMeta": true,
    "autoCatalogSteward": true,
    "autoCatalogIndex": true,
    "catalogProbeLimit": 6,
    "catalogInspectLimit": 5,
    "autoPsi": true,
    "autoApplySameAs": true,
    "sameAsVerified": {
      "linkedinUrl": "https://www.linkedin.com/company/zigmatechnologiesind"
    },
    "gbp": {
      "foundingYear": "2006",
      "primaryCategory": "Solar energy company",
      "whatsappDigits": "919590137666",
      "categories": [
        "Solar energy company",
        "Solar energy system service",
        "Electrical installation service",
        "Energy equipment and solutions",
        "Battery wholesaler",
        "Electric vehicle charging station contractor"
      ],
      "services": [
        "Solar EPC (rooftop and ground-mount)",
        "UPS supply and installation",
        "UPS AMC and repair",
        "Battery energy storage (BESS)",
        "EV charger installation",
        "Electrical field services and commissioning"
      ],
      "serviceAreas": ["Bengaluru", "Chennai", "Hyderabad", "Mumbai", "Pune", "Delhi"]
    },
    "richResultsPages": [
      { "path": "/", "expect": ["Organization", "LocalBusiness"] },
      { "path": "/projects", "expect": ["BreadcrumbList"] },
      { "path": "/projects/amc-engineering-college-200kw-bangalore", "expect": ["BreadcrumbList"] },
      { "path": "/products", "expect": ["BreadcrumbList"] },
      { "path": "/services", "expect": ["BreadcrumbList"] },
      { "path": "/contact", "expect": ["BreadcrumbList"] }
    ],
    "closedLoopHealthLimit": 40,
    "commandBrief": {
      "windowDays": 28,
      "topN": 15,
      "theme": "aurora",
      "comparePrevious": true,
      "title": "SEO Command Brief",
      "sections": [
        "overview",
        "verify",
        "insights",
        "gsc",
        "bing",
        "ga4",
        "technical",
        "catalog",
        "conversion",
        "actions"
      ]
    }
  },
  "outputDir": "../../storage/meridian/zigma-prod"
}
