    "ztools:emulator:reset": "npm run emulator:reset --prefix apps/ztools-mobile",
    "ztools:emulator:wait": "npm run emulator:wait --prefix apps/ztools-mobile",
    "ztools:emulator:network": "npm run emulator:network --prefix apps/ztools-mobile",
    "ztools:adb:devices": "npm run adb:devices --prefix apps/ztools-mobile",
